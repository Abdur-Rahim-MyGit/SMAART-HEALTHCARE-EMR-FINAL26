# ---- SMAART Healthcare EMR API : environment template (never commit real values) ----
NODE_ENV=development
PORT=5001
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL (application role: DML only, subject to row level security)
DATABASE_URL=postgres://smaart_app:smaart_dev@localhost:5432/smaart_emr
# PostgreSQL (migration role: owns the schema; used by `npm run migrate`)
MIGRATION_DATABASE_URL=postgres://smaart_migrator:smaart_dev@localhost:5432/smaart_emr
APP_DB_ROLE=smaart_app
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# MongoDB (flexible clinical documents). Optional in development, required in production.
MONGODB_URI=mongodb://localhost:27017/smaart_emr
# Redis (rate limiting, cache, locks). Optional in development (memory fallback), required in production.
REDIS_URL=redis://localhost:6379
# RabbitMQ (async events). Optional in development, required in production.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=smaart.events

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=smaart_rt
# Password-only login (/auth/login without OTP) is only for development; production refuses it.
AUTH_ALLOW_PASSWORD_ONLY_LOGIN=true
OTP_LOGIN_TTL_MINUTES=5
OTP_RESET_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# HTTP
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
FHIR_RATE_LIMIT_MAX=120

# Email: smtp | console (prints to stdout, development only) | none
EMAIL_TRANSPORT=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SMAART Healthcare <no-reply@example.com>

# Files: cloudinary (current production storage) | local (development/tests only)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smaart-emr
LOCAL_STORAGE_DIR=./storage
DOCUMENT_ACCESS_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760

FHIR_BASE_URL=http://localhost:5001/api/fhir/R4
METRICS_ENABLED=true

# Bootstrap of the first Super Master Admin (`npm run bootstrap:admin`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Optional: malware scanning of uploads through a ClamAV daemon
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional: nightly document backup export (manifest + verified file copies)
BACKUP_DIR=
BACKUP_COPY_FILES=false
